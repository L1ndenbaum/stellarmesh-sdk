{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellarmesh.dev/contracts/storage/v1/access-config.schema.json",
  "title": "Storage v1 项目访问配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespaces", "principals"],
  "properties": {
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/namespace"}
    },
    "principals": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/principal"}
    }
  },
  "$defs": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "prefix"],
      "properties": {
        "bucket": {"type": "string", "minLength": 1},
        "prefix": {"type": "string"}
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "grants"],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 32}
        },
        "grants": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["read", "write", "delete"]}
          }
        }
      }
    }
  }
}
