{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellarmesh.dev/contracts/logging/v2/dead-letter-v2.schema.json",
  "title": "LoggingOversizeDeadLetterV2ForLogEventV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_topic",
    "source_partition",
    "source_offset",
    "reason",
    "error",
    "source_key_bytes",
    "source_key_sha256",
    "payload_bytes",
    "payload_sha256",
    "content_omitted",
    "failed_at"
  ],
  "properties": {
    "schema_version": {"const": "v2"},
    "source_topic": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "source_partition": {"type": "integer", "minimum": 0},
    "source_offset": {"type": "integer", "minimum": 0},
    "source_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "reason": {"const": "source_message_too_large"},
    "error": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"},
    "source_key_bytes": {"type": "integer", "minimum": 0},
    "source_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_bytes": {"type": "integer", "minimum": 0},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_omitted": {"const": true},
    "failed_at": {"type": "string", "format": "date-time"}
  }
}
