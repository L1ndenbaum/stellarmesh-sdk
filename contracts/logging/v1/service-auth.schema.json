{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/L1ndenbaum/stellarmesh-sdk/contracts/logging/v1/service-auth.schema.json",
  "title": "Stellarmesh Logging Service Auth v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["services"],
  "properties": {
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 32
        }
      }
    }
  }
}
