{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/L1ndenbaum/stellarmesh-sdk/contracts/logging/v1/log-event.schema.json",
  "title": "Stellarmesh LogEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "level",
    "service",
    "message",
    "trace_id",
    "metadata"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "AUDIT"]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
