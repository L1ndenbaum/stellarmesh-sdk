{
  "name": "stellarmesh-sdk",
  "version": "0.1.0",
  "description": "可复用的 Axios HTTP 客户端",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "eslint . --fix && prettier --write .",
    "check": "prettier --check . && eslint . && tsc --noEmit -p tsconfig.check.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser && npm run test:consumer"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18"
  }
}
